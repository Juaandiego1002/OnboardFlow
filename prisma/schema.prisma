generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Admin {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String    @default("")
  resetToken      String?
  resetTokenExpiry DateTime?
  sessions        Session[]
  employees       Employee[]
  processes       OnboardingProcess[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Employee {
  id        String   @id @default(cuid())
  name      String
  email     String
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, adminId])
}

model Session {
  id              String    @id @default(cuid())
  adminId         String
  admin           Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  token           String    @unique
  expiresAt       DateTime
  pendingExpireAt DateTime?
  createdAt       DateTime  @default(now())
}

model OnboardingProcess {
  id             String   @id @default(cuid())
  name           String
  description    String   @default("")
  durationWeeks  Int      @default(4)
  adminId        String
  admin          Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  steps          Step[]
  invites        Invite[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Step {
  id            String   @id @default(cuid())
  title         String
  description   String   @default("")
  week          Int
  type          String   @default("task") // task, reading, meeting
  materialUrl   String   @default("")
  order         Int      @default(0)
  processId     String
  process       OnboardingProcess @relation(fields: [processId], references: [id], onDelete: Cascade)
  progress      Progress[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Invite {
  id              String    @id @default(cuid())
  processId       String
  process         OnboardingProcess @relation(fields: [processId], references: [id], onDelete: Cascade)
  employeeName    String
  employeeEmail   String
  token           String    @unique
  expiresAt       DateTime
  progress        Progress[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Progress {
  id           String    @id @default(cuid())
  inviteId     String
  invite       Invite    @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  stepId       String
  step         Step      @relation(fields: [stepId], references: [id], onDelete: Cascade)
  completedAt  DateTime  @default(now())
  evidence     String    @default("")
  evidenceUrl  String    @default("")
  verifiedAt   DateTime?
  verifiedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([inviteId, stepId])
}
